{
  "expo": {
    "name": "Habits Tracker",
    "slug": "habits-tracker",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.andre.habitstracker",
      "versionCode": 3,
      "icon": "./src/Resources/app-launcher-badge.png",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-notifications"
    ]
  }
}
